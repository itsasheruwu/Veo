<UserControl
    x:Class="Veo_Windows.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="SettingHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="SettingIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="SettingDivider" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="52,0,0,0"/>
        </Style>
        <Style x:Key="SettingSegment" TargetType="ToggleButton">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="SettingsLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailWidth" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="SettingsRail">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="16,0,16,12"
                       AutomationProperties.HeadingLevel="Level1"/>
            <ListView x:Name="Categories" Grid.Row="1" SelectionMode="Single" Padding="9,2"
                      SelectionChanged="Category_Changed" AutomationProperties.Name="Settings categories"
                      AutomationProperties.AutomationId="SettingsCategories">
                <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                <ListView.Resources>
                    <x:Double x:Key="ListViewItemMinHeight">46</x:Double>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="46"/>
                        <Setter Property="Margin" Value="0,0,0,3"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <Border Grid.Row="2" Padding="9,7" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Button x:Name="BackButton" Click="Back_Click" Height="34" Padding="9,0" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="Back to workspace" AutomationProperties.AutomationId="SettingsBack">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                        <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
        <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                      AutomationProperties.Name="Settings page" AutomationProperties.AutomationId="SettingsScroll">
            <Grid>
            <StackPanel x:Name="Document" HorizontalAlignment="Center" Width="760" Padding="32,32,32,40">
                <StackPanel Margin="0,0,0,30" Spacing="6">
                    <TextBlock x:Name="PageTitle" FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="SettingsPageTitle"/>
                    <TextBlock x:Name="PageDetail" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Grid x:Name="FeedbackSurface" CornerRadius="8" Margin="0,0,0,12"><InfoBar x:Name="Feedback" Background="Transparent" IsClosable="True" IsOpen="False"/></Grid>
                <StackPanel x:Name="Sections" Spacing="22"/>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
