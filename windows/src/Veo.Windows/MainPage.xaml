<Page x:Class="Veo_Windows.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Veo_Windows.Controls" xmlns:vm="using:Veo_Windows.ViewModels">
 <Page.Resources>
  <ResourceDictionary>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ComposerProviderPillFill" Color="#0D000000"/></ResourceDictionary>
   <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ComposerProviderPillFill" Color="#0DFFFFFF"/></ResourceDictionary>
   <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ComposerProviderPillFill" Color="{ThemeResource SystemColorButtonFaceColor}"/></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <CollectionViewSource x:Name="GroupedChats" IsSourceGrouped="True"/>
  <x:Double x:Key="ConversationMaxWidth">820</x:Double>
  <Style x:Key="ComposerAttachmentChip" TargetType="Border">
   <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
   <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="8,2,3,2"/>
  </Style>
  <Style x:Key="ComposerChromeButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
   <Setter Property="MinWidth" Value="0"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="CornerRadius" Value="7"/>
   <Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
       <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
         <VisualState x:Name="Normal"/>
         <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverLayer.Opacity" Value="1"/></VisualState.Setters></VisualState>
         <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverLayer.Opacity" Value="1"/><Setter Target="Face.Opacity" Value="0.7"/></VisualState.Setters></VisualState>
         <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Face.Opacity" Value="0.42"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
       </VisualStateManager.VisualStateGroups>
       <Border x:Name="HoverLayer" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
       <ContentPresenter x:Name="Face" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                         Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ComposerModePillButton" TargetType="Button" BasedOn="{StaticResource ComposerChromeButton}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="ModelPickerFlyoutPresenter" TargetType="FlyoutPresenter">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="MinWidth" Value="0"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="MaxWidth" Value="332"/>
   <Setter Property="IsDefaultShadowEnabled" Value="False"/>
   <Setter Property="CornerRadius" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="ModelDropdownPresenter" TargetType="MenuFlyoutPresenter">
   <Setter Property="MinWidth" Value="158"/>
   <Setter Property="MaxWidth" Value="312"/>
   <Setter Property="Padding" Value="5"/>
   <Setter Property="CornerRadius" Value="10"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
  </Style>
  <Style x:Key="ModelOptionsPresenter" TargetType="FlyoutPresenter">
   <Setter Property="MinWidth" Value="258"/>
   <Setter Property="MaxWidth" Value="258"/>
   <Setter Property="Padding" Value="4,6,4,4"/>
   <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
   <Setter Property="XYFocusKeyboardNavigation" Value="Enabled"/>
  </Style>
  <Style x:Key="ModelDropdownItem" TargetType="MenuFlyoutItem">
   <Setter Property="MinHeight" Value="23"/>
   <Setter Property="Padding" Value="5,3"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="MenuFlyoutItem">
      <Grid x:Name="Row" Background="Transparent" CornerRadius="5">
       <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
         <VisualState x:Name="Normal"/>
         <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Row.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
         <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Row.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters></VisualState>
         <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Face.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
       </VisualStateManager.VisualStateGroups>
       <ContentPresenter x:Name="Face" Content="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}"
                         Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ComposerFlyoutPresenter" TargetType="FlyoutPresenter">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="MinWidth" Value="0"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="MaxWidth" Value="360"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Background" Value="{ThemeResource FlyoutPresenterBackground}"/>
   <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  </ResourceDictionary>
 </Page.Resources>
 <Grid>
 <Grid x:Name="Shell" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarWidth" Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="UtilitySashWidth" Width="8"/><ColumnDefinition x:Name="UtilityWidth" Width="360"/></Grid.ColumnDefinitions>
  <Grid x:Name="SidebarPanel" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="1" Margin="8,1,8,6">
    <Button Click="New_Click" Style="{StaticResource SubtleButtonStyle}" MinHeight="31" Padding="7,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="New chat" AutomationProperties.AutomationId="NewChat">
     <StackPanel Orientation="Horizontal" Spacing="10">
      <FontIcon Glyph="&#xE70F;" Width="16" FontSize="15"/>
      <TextBlock Text="New Chat" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Button x:Name="SidebarSearchToggle" Click="SidebarSearch_Click" Style="{StaticResource SubtleButtonStyle}" MinHeight="31" Padding="7,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Search chats" AutomationProperties.AutomationId="SidebarSearchToggle">
     <StackPanel Orientation="Horizontal" Spacing="10">
      <FontIcon Glyph="&#xE721;" Width="16" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock Text="Search" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <TextBox x:Name="SearchBox" PlaceholderText="Search every project" Margin="4,2,4,1" Visibility="Collapsed" TextChanged="Search_Changed" KeyDown="SidebarSearch_KeyDown" AutomationProperties.Name="Search every project" AutomationProperties.AutomationId="SearchChats"/>
   </StackPanel>
   <Grid Grid.Row="1" Margin="13,0,9,1">
    <TextBlock x:Name="SidebarCatalogLabel" Text="Chats" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
     <Button Style="{StaticResource SubtleButtonStyle}" Click="SidebarOptions_Click" ToolTipService.ToolTip="Chat options" AutomationProperties.Name="Chat options" MinHeight="0" Width="28" Height="26" Padding="0"><FontIcon Glyph="&#xE71C;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/></Button>
     <Button Style="{StaticResource SubtleButtonStyle}" Click="OpenProject_Click" ToolTipService.ToolTip="Open project" AutomationProperties.Name="Open project" MinHeight="0" Width="28" Height="26" Padding="0"><FontIcon Glyph="&#xE838;" FontSize="15"/></Button>
    </StackPanel>
   </Grid>
   <ListView x:Name="ChatList" Grid.Row="2" SelectionChanged="Chat_Changed" RightTapped="Chat_RightTapped" SelectionMode="Single" Padding="4,0" AutomationProperties.Name="Chats">
    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
    <ListView.Resources>
     <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>
     <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
     <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
     <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
     <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
    </ListView.Resources>
    <ListView.ItemContainerStyle>
     <Style TargetType="ListViewItem">
      <Setter Property="MinHeight" Value="29"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
     </Style>
    </ListView.ItemContainerStyle>
    <ListView.GroupStyle>
     <GroupStyle>
      <GroupStyle.HeaderContainerStyle>
       <Style TargetType="ListViewHeaderItem">
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="ListViewHeaderItem">
           <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </GroupStyle.HeaderContainerStyle>
      <GroupStyle.HeaderTemplate>
       <DataTemplate x:DataType="vm:ChatGroup">
        <Button Style="{StaticResource SubtleButtonStyle}" Tag="{x:Bind ProjectPath}" Click="ProjectGroup_Click" AutomationProperties.Name="{x:Bind AccessibleLabel}" Padding="8,2" Height="25" MinHeight="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
         <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="{x:Bind Chevron}" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <FontIcon Grid.Column="1" Glyph="{x:Bind Icon}" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
          <TextBlock Grid.Column="2" Text="{x:Bind Key}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
         </Grid>
        </Button>
       </DataTemplate>
      </GroupStyle.HeaderTemplate>
     </GroupStyle>
    </ListView.GroupStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="vm:ChatRow">
     <Grid MinHeight="29" AutomationProperties.Name="{x:Bind AccessibleLabel}">
      <Border Style="{StaticResource RoundedSidebarHighlight}" Opacity="{x:Bind HighlightOpacity, Mode=OneWay}" Margin="1"/>
      <Grid Padding="14,3,10,3" ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="{x:Bind Age}" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
      </Grid>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="12,6,9,8">
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Width="8" Height="8" VerticalAlignment="Center">
      <Ellipse Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
      <Ellipse x:Name="ReadyRuntimeDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/>
     </Grid>
     <TextBlock x:Name="RuntimeLabel" Grid.Column="1" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" MinHeight="0" Width="28" Height="28" Padding="0" Click="Settings_Click" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="Settings"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Column="1" Margin="12,0,12,10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="TimelineHeight" Height="*"/><RowDefinition x:Name="TerminalHeight" Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="WelcomeBottom" Height="0"/></Grid.RowDefinitions>
   <StackPanel x:Name="ChatHeader" Margin="12,4,12,8" MaxWidth="{StaticResource ConversationMaxWidth}" Spacing="4">
    <Grid x:Name="ChatIdentity" ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ChatTitle" Text="New chat" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="CwdLabel" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error"/>
   </StackPanel>
   <ListView x:Name="Timeline" Grid.Row="1" SelectionMode="None" Padding="0,0,0,12" MaxWidth="{StaticResource ConversationMaxWidth}" HorizontalContentAlignment="Stretch">
    <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
    <ListView.ItemTemplate>
     <DataTemplate x:DataType="vm:MessageRow">
      <local:TimelineMessageView Row="{x:Bind}" Margin="0,7,0,9"
                                 PromptBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                                 SecondaryForeground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="WelcomeHeading" Grid.Row="1" Text="What should we work on?" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,14" Visibility="Collapsed"/>
   <ContentControl x:Name="TerminalHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <StackPanel Grid.Row="3" Spacing="8" MaxWidth="{StaticResource ConversationMaxWidth}"><ContentControl x:Name="ApprovalReviewHost"/><StackPanel x:Name="PendingPanel" Spacing="8"/></StackPanel>
   <Border x:Name="ComposerPanel" Grid.Row="5" MaxWidth="{StaticResource ConversationMaxWidth}" Margin="4,0,4,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" SizeChanged="ComposerPanel_SizeChanged">
    <Grid>
    <Canvas x:Name="ComposerDictationEffects" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw"/>
    <StackPanel>
     <Border x:Name="QueueShelf" Visibility="Collapsed" CornerRadius="15,15,0,0"
             Background="{ThemeResource SubtleFillColorSecondaryBrush}"
             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <StackPanel x:Name="QueuePanel" Padding="13,8,13,9" Spacing="4"
                  AutomationProperties.Name="Queued follow-ups"/>
     </Border>
     <StackPanel Padding="12" Spacing="8">
      <StackPanel x:Name="ComposerInputs" Spacing="6" Visibility="Collapsed"/>
      <Grid>
      <local:ChatComposerBox x:Name="Composer" PlaceholderText="Send follow-up" AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MinHeight="34" MaxHeight="110" FontSize="14" BorderThickness="0" Background="Transparent" Padding="5,8,5,0" TextChanged="Composer_Changed" AllowDrop="True" DragOver="Composer_DragOver" Drop="Composer_Drop" AutomationProperties.Name="Message Codex" AutomationProperties.AutomationId="Composer">
       <local:ChatComposerBox.Resources>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
       </local:ChatComposerBox.Resources>
      </local:ChatComposerBox>
      <Grid x:Name="DictationEditor" Visibility="Collapsed" Padding="5,8,0,0" MinHeight="104" ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="DictationScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
        <TextBlock x:Name="DictationTranscript" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
       </ScrollViewer>
       <StackPanel Grid.Column="1" Spacing="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Ellipse x:Name="DictationIndicator" Width="5" Height="5" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                 AutomationProperties.AccessibilityView="Raw"/>
        <TextBlock x:Name="DictationStatus" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
        <Button Style="{StaticResource ComposerChromeButton}" Padding="0" Width="19" Height="19" Click="CancelDictation_Click"
                ToolTipService.ToolTip="Cancel dictation (Esc)" AutomationProperties.Name="Cancel dictation" AutomationProperties.AutomationId="CancelDictation">
         <FontIcon Glyph="&#xE711;" FontSize="8"/>
         <Button.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="CancelDictationShortcut"/></Button.KeyboardAccelerators>
        </Button>
       </StackPanel>
       <Button x:Name="FinishDictationButton" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
               Style="{StaticResource ComposerChromeButton}" Width="28" Height="28" CornerRadius="14"
               Background="{ThemeResource SubtleFillColorSecondaryBrush}" Click="Dictate_Click"
               ToolTipService.ToolTip="Finish dictation (Ctrl+Shift+D)" AutomationProperties.Name="Finish dictation"
               AutomationProperties.AutomationId="FinishDictation">
        <FontIcon x:Name="FinishDictationGlyph" Glyph="&#xE71A;" FontSize="11" AutomationProperties.AccessibilityView="Raw"/>
        <Button.KeyboardAccelerators><KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="DictateShortcut"/></Button.KeyboardAccelerators>
       </Button>
      </Grid>
      </Grid>
      <InfoBar x:Name="DictationError" Severity="Warning" IsOpen="False" IsClosable="True" Title="Dictation" />
      <Grid x:Name="ComposerToolbar" ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Button x:Name="ComposerOptionsButton" Style="{StaticResource ComposerChromeButton}" Width="27" Height="27" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Click="ComposerOptions_Click" ToolTipService.ToolTip="Composer options" AutomationProperties.Name="Composer options" AutomationProperties.AutomationId="ComposerOptions">
        <FontIcon Glyph="&#xE710;" FontSize="12"/>
       </Button>
       <Grid x:Name="ModelPickerSlot" Grid.Column="1" ColumnSpacing="5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="ProviderTrigger" Height="26" Padding="7,0" CornerRadius="13" Background="{ThemeResource ComposerProviderPillFill}" Style="{StaticResource ComposerChromeButton}" Click="Provider_Click" ToolTipService.ToolTip="Change provider" AutomationProperties.Name="Change provider" AutomationProperties.AutomationId="ProviderPicker">
        <Grid x:Name="ProviderPillSurface">
        <StackPanel x:Name="ProviderPillFace" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
         <ContentPresenter x:Name="ComposerProviderMark" Width="19" Height="19" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
         <TextBlock x:Name="ComposerProviderName" Text="Codex" FontSize="11.5" FontWeight="Medium" MaxWidth="112"
                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
         <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False"/>
        </StackPanel>
        </Grid>
       </Button>
       <Button x:Name="ModelTrigger" Grid.Column="1" Height="26" Padding="7,0" CornerRadius="13"
               Background="{ThemeResource ComposerProviderPillFill}" Style="{StaticResource ComposerChromeButton}"
               Click="Model_Click" AutomationProperties.Name="Select model" AutomationProperties.AutomationId="ModelPicker">
        <Grid x:Name="ModelPillSurface">
         <StackPanel x:Name="ModelTriggerLabel" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Path x:Name="ModelSpeedMark" Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
          <Grid x:Name="ModelMarkHost" Width="14" Height="16" IsHitTestVisible="False" VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw">
           <Path x:Name="ModelCube" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Data="M6,0.75 L11,3.5 L11,8.5 L6,11.25 L1,8.5 L1,3.5 Z M1,3.5 L6,6.25 L11,3.5 M6,6.25 L6,11.25"
                 Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.05"/>
           <FontIcon x:Name="ModelMark" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="ModelLabel" FontSize="11.5" FontWeight="Medium" Text="Select model" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock x:Name="ModelEffortLabel" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
          <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
         </StackPanel>
        </Grid>
       </Button>
       </Grid>
       <Button x:Name="AccessButton" Grid.Column="2" Height="26" CornerRadius="13"
               Background="{ThemeResource ComposerProviderPillFill}" Style="{StaticResource ComposerChromeButton}"
               HorizontalAlignment="Left" Padding="7,0" Click="ComposerAccess_Click"
               AutomationProperties.Name="Permissions" AutomationProperties.AutomationId="ComposerAccess">
        <Grid x:Name="AccessPillSurface">
         <StackPanel x:Name="AccessPillFace" Orientation="Horizontal" Spacing="5">
         <FontIcon x:Name="AccessIcon" Glyph="&#xE70F;" FontSize="11"/>
         <TextBlock x:Name="AccessLabel" Text="Auto-accept edits" FontSize="11.5"
                    FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
         <FontIcon x:Name="AccessChevron" Glyph="&#xE70D;" FontSize="8"/>
         </StackPanel>
        </Grid>
       </Button>
       <StackPanel x:Name="ComposerSendControls" Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <TextBlock x:Name="ComposerKeyHints" Text="↩ send · ⇧↩ newline" FontSize="10.5" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
        <Button x:Name="ComposerContextIndicator" Height="25" MinWidth="28" Padding="2,0"
                Style="{StaticResource ComposerChromeButton}" Visibility="Collapsed" Click="ContextIndicator_Click"
                AutomationProperties.Name="Context window usage" AutomationProperties.AutomationId="ComposerContextUsage">
         <TextBlock x:Name="ComposerContextPercent" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
        </Button>
        <StackPanel x:Name="ComposerModePills" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
         <Button x:Name="ComposerPlanPill" Style="{StaticResource ComposerModePillButton}" Click="ComposerModePill_Click"
                 Visibility="Collapsed" ToolTipService.ToolTip="Turn off Plan"
                 AutomationProperties.Name="Turn off Plan" AutomationProperties.AutomationId="ComposerPlanPill"/>
         <Button x:Name="ComposerDebugPill" Style="{StaticResource ComposerModePillButton}" Click="ComposerModePill_Click"
                 Visibility="Collapsed" ToolTipService.ToolTip="Turn off Debug"
                 AutomationProperties.Name="Turn off Debug" AutomationProperties.AutomationId="ComposerDebugPill"/>
         <Button x:Name="ComposerGoalPill" Style="{StaticResource ComposerModePillButton}" Click="ComposerGoalPill_Click"
                 Visibility="Collapsed" ToolTipService.ToolTip="Turn off Goal"
                 AutomationProperties.Name="Turn off Goal" AutomationProperties.AutomationId="ComposerGoalPill"/>
        </StackPanel>
        <Button x:Name="DictateButton" Style="{StaticResource ComposerChromeButton}" Width="28" Height="28" CornerRadius="14"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}" Click="Dictate_Click" ToolTipService.ToolTip="Dictate (Ctrl+Shift+D)"
                AutomationProperties.Name="Dictate" AutomationProperties.AutomationId="Dictate" IsEnabled="False">
         <FontIcon x:Name="DictateGlyph" Glyph="&#xE720;" FontSize="13" AutomationProperties.AccessibilityView="Raw"/>
         <Button.KeyboardAccelerators><KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="DictateShortcut"/></Button.KeyboardAccelerators>
        </Button>
        <Button x:Name="SendButton" Style="{StaticResource ComposerChromeButton}" Width="28" Height="28" CornerRadius="14" Click="Send_Click" ToolTipService.ToolTip="Send" AutomationProperties.Name="Send" AutomationProperties.AutomationId="Send">
         <Grid x:Name="SendFace" Width="28" Height="28" CornerRadius="14" Background="{ThemeResource TextFillColorPrimaryBrush}">
          <FontIcon x:Name="SendGlyph" Glyph="&#xE74A;" FontSize="12" Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
         </Grid>
        </Button>
        <Button x:Name="StopButton" Style="{StaticResource ComposerChromeButton}" Width="28" Height="28" CornerRadius="14" Background="#E04447" Foreground="White" Click="Stop_Click" ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop" AutomationProperties.AutomationId="Stop" Visibility="Collapsed">
         <Rectangle Width="9" Height="9" RadiusX="1" RadiusY="1" Fill="White"/>
        </Button>
       </StackPanel>
      </Grid>
     </StackPanel>
     <Border x:Name="WelcomeProjectRow" Height="38" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed">
      <Button x:Name="WelcomeProjectButton" Style="{StaticResource ComposerChromeButton}" Width="220" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ComposerProject_Click" AutomationProperties.Name="Choose project" AutomationProperties.AutomationId="ComposerProject">
       <Grid ColumnSpacing="7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
        <TextBlock x:Name="WelcomeProjectLabel" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
       </Grid>
      </Button>
     </Border>
    </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <ContentControl x:Name="UtilitySashHost" Grid.Column="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid Grid.Column="3" x:Name="UtilityPanel">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TabView x:Name="UtilityTabs" TabWidthMode="SizeToContent" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" SelectedIndex="0"
            SelectionChanged="Utility_Changed" AutomationProperties.AutomationId="UtilityTabs" AutomationProperties.Name="Right panel tabs">
    <TabView.TabItems>
     <TabViewItem Header="Review" IsClosable="False"><TabViewItem.IconSource><SymbolIconSource Symbol="Document"/></TabViewItem.IconSource></TabViewItem>
     <TabViewItem Header="Browser" IsClosable="False"><TabViewItem.IconSource><SymbolIconSource Symbol="World"/></TabViewItem.IconSource></TabViewItem>
     <TabViewItem Header="Files" IsClosable="False"><TabViewItem.IconSource><SymbolIconSource Symbol="Folder"/></TabViewItem.IconSource></TabViewItem>
     <TabViewItem Header="Side chat" IsClosable="False"><TabViewItem.IconSource><SymbolIconSource Symbol="Message"/></TabViewItem.IconSource></TabViewItem>
    </TabView.TabItems>
   </TabView>
   <ContentControl x:Name="UtilityHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
 </Grid>
 <ContentControl x:Name="SettingsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
 </Grid>
</Page>
