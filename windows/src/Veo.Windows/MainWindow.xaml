<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Veo_Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Veo_Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Veo"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="CaptionCommand" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Height="32" MinHeight="32">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
            </TitleBar.Resources>
            <TitleBar.LeftHeader>
                <Grid x:Name="SidebarToggleSlot" Width="280">
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="12,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/TitleBarIcon.png" Width="12" Height="12"
                               VerticalAlignment="Center" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Veo" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="VeoTitleBarLabel" />
                    </StackPanel>
                    <Button x:Name="SidebarToggle" Style="{StaticResource CaptionCommand}"
                            HorizontalAlignment="Right" Margin="0,0,4,0"
                            TitleBar.IsDragRegion="False" Click="Sidebar_Click"
                            ToolTipService.ToolTip="Hide sidebar" AutomationProperties.Name="Hide sidebar"
                            AutomationProperties.AutomationId="SidebarToggle">
                        <FontIcon Glyph="&#xE90C;" FontSize="12" />
                    </Button>
                </Grid>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel x:Name="ToolbarCommands" Orientation="Horizontal" TitleBar.IsDragRegion="False">
                    <Button Style="{StaticResource CaptionCommand}" Click="NewChat_Click" ToolTipService.ToolTip="New chat"
                            AutomationProperties.Name="New chat" AutomationProperties.AutomationId="CaptionNewChat">
                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                    </Button>
                    <ToggleButton x:Name="TemporaryChatButton" Width="36" Height="32" MinWidth="0" MinHeight="0"
                                  Padding="0" BorderThickness="0" Background="Transparent"
                                  Visibility="Collapsed" Click="TemporaryChat_Click"
                                  ToolTipService.ToolTip="Make this chat temporary" AutomationProperties.Name="Make this chat temporary"
                                  AutomationProperties.AutomationId="TemporaryChat">
                        <FontIcon Glyph="&#xE916;" FontSize="12" />
                    </ToggleButton>
                    <Button Style="{StaticResource CaptionCommand}" Click="Worktrees_Click" ToolTipService.ToolTip="Project worktrees"
                            AutomationProperties.Name="Project worktrees" AutomationProperties.AutomationId="CaptionWorktrees">
                        <FontIcon Glyph="&#xE838;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CaptionCommand}" Click="ProjectActions_Click" ToolTipService.ToolTip="Project actions"
                            AutomationProperties.Name="Project actions" AutomationProperties.AutomationId="ProjectActions" x:Name="ProjectActionsButton" IsEnabled="False">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CaptionCommand}" Click="Reveal_Click" ToolTipService.ToolTip="Reveal project"
                            AutomationProperties.Name="Reveal project" AutomationProperties.AutomationId="CaptionRevealProject">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CaptionCommand}" Click="Terminal_Click" ToolTipService.ToolTip="Terminal"
                            AutomationProperties.Name="Terminal" AutomationProperties.AutomationId="CaptionTerminal">
                        <FontIcon Glyph="&#xE756;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CaptionCommand}" Click="Inspector_Click" ToolTipService.ToolTip="Utility panel"
                            AutomationProperties.Name="Utility panel" AutomationProperties.AutomationId="CaptionUtility">
                        <FontIcon Glyph="&#xE89F;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CaptionCommand}" ToolTipService.ToolTip="More actions"
                            AutomationProperties.Name="More actions" AutomationProperties.AutomationId="CaptionMore">
                        <FontIcon Glyph="&#xE712;" FontSize="12" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Chat catalog and search" Click="Catalog_Click" />
                                <MenuFlyoutItem Text="History and forks" Click="History_Click" />
                                <MenuFlyoutItem Text="Workspace checkpoints" Click="Checkpoints_Click" />
                                <MenuFlyoutItem Text="Queued prompts" Click="Queue_Click" />
                                <MenuFlyoutItem Text="Realtime voice" Click="Voice_Click" />
                                <MenuFlyoutItem Text="Saved prompts" Click="Prompts_Click" />
                                <MenuFlyoutItem Text="Pull requests" Click="PullRequests_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
